# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_attendance_db
DB_USER=sam_user
DB_PASSWORD=your_db_password_here

# JWT Configuration (SAM-NF-003 / SAM-SR-001 — all auth over HTTPS/TLS)
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h

# Server
PORT=5000
NODE_ENV=development

# Production transport settings. Set TRUSTED_PROXY_IPS to the exact IPs/CIDRs
# of the TLS-terminating proxy. Leave empty when this app terminates TLS itself.
TRUSTED_PROXY_IPS=
ALLOWED_ORIGINS=https://attendance.example.edu
# For direct TLS termination, configure both paths to deployment-provided files.
TLS_KEY_PATH=
TLS_CERT_PATH=

# Reliability (pool queue is bounded; only the safe startup probe is retried)
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=3000
DB_PROBE_TIMEOUT_MS=3000
DB_STARTUP_ATTEMPTS=3
DB_STARTUP_RETRY_DELAY_MS=250
SHUTDOWN_TIMEOUT_MS=10000

# Production transport settings. Set TRUSTED_PROXY_IPS to the exact IPs/CIDRs
# of the TLS-terminating proxy. Leave empty when this app terminates TLS itself.
TRUSTED_PROXY_IPS=
ALLOWED_ORIGINS=
# For direct TLS termination, configure both paths to deployment-provided files.
TLS_KEY_PATH=
TLS_CERT_PATH=

# Rate Limiting (STRIDE DoS mitigation)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Attendance policy (defaults to the approved 75% threshold)
ATTENDANCE_THRESHOLD=75

# SAM-NF-004: Backup configuration
# BACKUP_DIR path relative to the project root (default: ./backups)
BACKUP_DIR=./backups
# Number of daily backups to retain before rotation
BACKUP_RETAIN=7
# Cron schedule (set up with: crontab -e)
# Daily at 02:00: 0 2 * * * /path/to/project/backend/scripts/backup.sh
