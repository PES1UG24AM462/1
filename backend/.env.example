# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_attendance_db
DB_USER=sam_user
DB_PASSWORD=your_db_password_here

# JWT Configuration (SAM-NF-003 / SAM-SR-001 — all auth over HTTPS/TLS)
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h

# Server
PORT=5000
NODE_ENV=development

# Rate Limiting (STRIDE DoS mitigation)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
